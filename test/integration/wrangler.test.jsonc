{
  "name": "edge-git-test",
  "main": "../../apps/api/src/index.ts",
  "compatibility_date": "2025-11-29",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "REPO", "class_name": "RepoWorker" },
      { "name": "CRON_TASKS", "class_name": "CronTasksWorker" }
    ]
  },
  "migrations": [
    { "tag": "v1000000000", "new_sqlite_classes": ["RepoWorker", "CronTasksWorker"] }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "edge-git-test-db", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "vars": {
    "DEV_AUTH_EMAIL": "test@example.com",
    "SERVE_SPA_FROM_WORKER": "false",
    "SITE_URL": "https://example.com"
  }
}
