{
  "name": "@edge-git/monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/sync-quickjs-wasm.mjs && node scripts/ensure-spa-shell-stub.mjs && pnpm run typegen",
    "build": "pnpm -r build",
    "checks": "pnpm -r typecheck && pnpm run lint && node scripts/check-god-files.mjs && pnpm run test:coverage && pnpm run test:integration",
    "prettier": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config test/integration/vitest.config.mts",
    "test:coverage:integration": "vitest run --coverage --config test/integration/vitest.config.mts",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint --fix --quiet .",
    "validate:locales": "node scripts/validate_locales.mjs",
    "typegen": "wrangler types --config ./apps/api/wrangler.template.jsonc --env-interface CloudflareEnv"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.3.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "i18next": "^26.4.2",
    "isomorphic-git": "^1.36.1",
    "jsdom": "26.1.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "7.18.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.10",
    "wrangler": "4.135.0"
  },
  "packageManager": "pnpm@11.2.2"
}
