{
  "name": "@edge-git/backend-services",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/*": "./src/auth/*.ts",
    "./fork": "./src/fork/index.ts",
    "./fork/*": "./src/fork/*.ts",
    "./repo": "./src/repo/index.ts",
    "./repo/*": "./src/repo/*.ts",
    "./user": "./src/user/index.ts",
    "./user/*": "./src/user/*.ts",
    "./issue": "./src/issue/index.ts",
    "./issue/*": "./src/issue/*.ts",
    "./pull": "./src/pull/index.ts",
    "./pull/*": "./src/pull/*.ts",
    "./org": "./src/org/index.ts",
    "./org/*": "./src/org/*.ts",
    "./team": "./src/team/index.ts",
    "./team/*": "./src/team/*.ts",
    "./audit": "./src/audit/index.ts",
    "./audit/*": "./src/audit/*.ts",
    "./permission": "./src/permission/index.ts",
    "./permission/*": "./src/permission/*.ts",
    "./protection": "./src/protection/index.ts",
    "./protection/*": "./src/protection/*.ts",
    "./search": "./src/search/index.ts",
    "./search/*": "./src/search/*.ts",
    "./social": "./src/social/index.ts",
    "./social/*": "./src/social/*.ts",
    "./webhook": "./src/webhook/index.ts",
    "./webhook/*": "./src/webhook/*.ts",
    "./collab": "./src/collab/index.ts",
    "./collab/*": "./src/collab/*.ts",
    "./discussion": "./src/discussion/index.ts",
    "./discussion/*": "./src/discussion/*.ts",
    "./project": "./src/project/index.ts",
    "./project/*": "./src/project/*.ts",
    "./snippet": "./src/snippet/index.ts",
    "./snippet/*": "./src/snippet/*.ts",
    "./wiki": "./src/wiki/index.ts",
    "./wiki/*": "./src/wiki/*.ts",
    "./release": "./src/release/index.ts",
    "./release/*": "./src/release/*.ts",
    "./transfer": "./src/transfer/index.ts",
    "./transfer/*": "./src/transfer/*.ts",
    "./deploykey": "./src/deploykey/index.ts",
    "./deploykey/*": "./src/deploykey/*.ts",
    "./security": "./src/security/index.ts",
    "./security/*": "./src/security/*.ts",
    "./composition": "./src/composition/index.ts",
    "./composition/*": "./src/composition/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@edge-git/backend-data": "workspace:*",
    "@edge-git/backend-errors": "workspace:*",
    "@edge-git/backend-runtime": "workspace:*",
    "@edge-git/git-protocol": "workspace:*",
    "@edge-git/git-service": "workspace:*",
    "@edge-git/shared": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "6.0.3"
  }
}
